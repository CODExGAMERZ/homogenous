{
  "name": "@codexgamerz/homogenous",
  "version": "3.7.0",
  "description": "Enterprise-grade local-first CLI coding assistant powered by multi-provider LLM inference, dynamic skills, and MCP tools",
  "type": "module",
  "main": "./dist/src/cli/index.js",
  "types": "./dist/src/cli/index.d.ts",
  "bin": {
    "homogenous": "dist/bin/homogenous.js"
  },
  "files": [
    "dist",
    "skills",
    ".toolrc.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx bin/homogenous.ts chat",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test test/**/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "coding-assistant",
    "ollama",
    "anthropic",
    "mcp"
  ],
  "author": "CODExGAMERZ",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-tiktoken": "^1.0.21",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
