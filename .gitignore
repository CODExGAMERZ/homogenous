# ------------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Package Manager Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Build Artifacts & Distribution Bundles
# ------------------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
tsconfig.tsbuildinfo
*.tgz
*.zip
*.tar.gz

# ------------------------------------------------------------------------------
# Security, Secrets & Environment Variables (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.pfx
*.p12
id_rsa
id_ed25519

# ------------------------------------------------------------------------------
# Homogenous Runtime State, Vaults & Local Configs
# ------------------------------------------------------------------------------
# Local user vaults and machine seeds
.homogenous/
keys.json
keys.bak.json
.keys.json
.vault_seed
*.vault_seed

# Project-specific persistent memory and local overrides
.agentmemory/
.toolrc.yaml
!.toolrc.example.yaml
.mcp.json
!.mcp.example.json

# ------------------------------------------------------------------------------
# Test Suites, Code Coverage & Scratchpads
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test/scratch_*
scratch/
tmp/
temp/

# ------------------------------------------------------------------------------
# Operating System Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------------------------------------------
